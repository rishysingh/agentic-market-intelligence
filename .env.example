# ==============================================================================
# Agentic Stock Market Intelligence Platform — Configuration Template
# Copy to .env for local development. NEVER commit real secrets or API keys.
# ==============================================================================

# 1. Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-03-c81d344a3430
GOOGLE_CLOUD_LOCATION=us-central1
GCP_REGION=us-central1
ENVIRONMENT=development

# 2. BigQuery Data Platform Configuration
BQ_DATASET_ID=market_intelligence
BQ_MAX_BYTES_BILLED=104857600

# 3. Google ADK & Gemini Model Configuration
ADK_ROOT_MODEL=gemini-2.5-pro
ADK_SPECIALIST_MODEL=gemini-2.5-flash
ADK_CRITIC_MODEL=gemini-2.5-pro
ADK_ENABLE_SEARCH_GROUNDING=true

# 4. Orchestrator & Execution Guardrails
ORCHESTRATOR_MAX_PARALLEL_AGENTS=6
ORCHESTRATOR_AGENT_TIMEOUT_SECONDS=45
ORCHESTRATOR_MAX_RETRIES=2
ORCHESTRATOR_TOKEN_BUDGET_PER_REQUEST=32000
MIN_DATA_FRESHNESS_HOURS=72
MIN_MODEL_BRIER_SKILL_SCORE=0.01
MIN_MODEL_ROC_AUC=0.52

# 5. Market Data & SEC EDGAR Configuration
SEC_EDGAR_USER_AGENT="AgenticMarketIntelligence/1.0 (research@example.com)"
MARKET_DATA_PRIMARY_PROVIDER=stooq_eod
# Optional licensed provider keys (loaded via Secret Manager in Cloud Run):
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=
FRED_API_KEY=

# 6. API Security & Rate Limiting
AMI_API_AUTH_TOKEN=dev-local-research-token-change-in-prod
AMI_RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ami-frontend-657944230490.us-central1.run.app

# 7. Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development
